 D("lotto","🎟️",["Yashirin lotereya bileti","Тайный лотерейный билет","Secret lottery ticket"],50,"Lottery"),
 D("singer","🎤",["To'yda 5 soat kuylovchi xonanda","Певец на свадьбу (5 часов)","Wedding singer for 5 hours"],800,"Wedding"),
 D("carpet","🧞",["Uchar gilam","Ковёр-самолёт","Flying carpet"],90000,"Flying carpet"),
 D("fish","🐠",["Oltin baliq (3 ta tilak)","Золотая рыбка (3 желания)","Goldfish (3 wishes)"],1e6,"Goldfish"),
 D("silk","🐫",["Ipak yo'li ruxsatnomasi","Пропуск на Шёлковый путь","Silk Road pass"],250,"Silk Road")
];
const DW = {pasp:"Diplomatic passport",qarz:"Ledger",btc:"Bitcoin",metro:"Tashkent Metro",fly:"Housefly",gun:"Water gun",pill:"Placebo",ufo:"Unidentified flying object",book:"Library",tunnel:"Tunnel",ninja:"Ninja",agent:"Espionage"};
ITEMS.forEach(i => { if (DW[i.id]) i.w = DW[i.id]; });
const ALL = Object.fromEntries(ITEMS.map(i => [i.id, i]));
const CITIES = {"Toshkent":[41.31,69.24],"Samarqand":[39.65,66.96],"Dubay":[25.2,55.27],"Moskva":[55.75,37.62],"London":[51.51,-0.13],"New York":[40.71,-74.0]};
const SHOPS = {"Toshkent":["Chorsu bozori","Toshkent City Mall","Mega Planet"],"Samarqand":["Registon bozori","Samarqand Darvoza"],"Dubay":["Dubai Mall","Gold Souk"],"Moskva":["GUM","Evropeyskiy"],"London":["Harrods","Camden Market"],"New York":["Fifth Avenue","Chelsea Market"]};
const TH = [1,10,30,60,90];

let R = {USD:1,RUB:85,UZS:12300}, live = false;
const SYM = {USD:"$",RUB:"₽",UZS:"so'm"};
const nav0 = (navigator.language||"uz").slice(0,2);
let S; try { S = JSON.parse(localStorage.getItem("bs")||"null"); } catch(e) {}
S = S || {lang: nav0==="ru"?"ru":nav0==="en"?"en":"uz", cur:"USD", city:"Toshkent", tab:"shop", cat:"all", ch:""};
let IC = {}; try { IC = JSON.parse(localStorage.getItem("ic")||"{}"); } catch(e) {}
const save = () => { try { localStorage.setItem("bs", JSON.stringify(S)); } catch(e) {} };
const t = k => T[S.lang][k];
const L = () => ({uz:0,ru:1,en:2})[S.lang];
const hash = s => { let h = 5381; for (const c of String(s)) h = ((h*33) ^ c.charCodeAt(0)) >>> 0; return h; };
const esc = s => String(s).replace(/[&<>"]/g, c => ({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"})[c]);
function fmt(u) {
  const v = u * R[S.cur], d = S.cur==="USD" && Math.abs(v) < 1e4 ? 2 : 0;
  const s = v.toLocaleString("ru-RU", {maximumFractionDigits:d, minimumFractionDigits:d});
  return S.cur==="USD" ? "$"+s : s+" "+SYM[S.cur];
}
let tt;
function toast(m, err) { const e=$("#toast"); e.textContent=m; e.className="show"+(err?" err":""); clearTimeout(tt); tt=setTimeout(()=>e.className="",3200); }
function coords() { return S.city==="📍" && S.loc ? S.loc : CITIES[S.city] || CITIES["Toshkent"]; }

function loadImgs() {
  document.querySelectorAll(".ph[data-w]").forEach(n => {
    const w = n.dataset.w; if (!w || n.dataset.d) return; n.dataset.d = 1;
    const put = u => { const i = new Image(); i.onload = () => n.appendChild(i); i.alt = ""; i.src = u; };
    if (IC[w]) return put(IC[w]);
    fetch("https://en.wikipedia.org/api/rest_v1/page/summary/"+encodeURIComponent(w))
      .then(r => r.json()).then(j => { const u = j.thumbnail && j.thumbnail.source; if (u) { IC[w]=u; try{localStorage.setItem("ic",JSON.stringify(IC));}catch(e){} put(u); } })
      .catch(() => {});
  });
}

function renderPick() {
  $("#pick").innerHTML = `<div class="row sp"><h1>${t("pick")}</h1>${langSel()}</div><p class="sub">${t("pickSub")}</p><div class="grid">` +
    CH.map(c => `<div class="card char" data-a="start" data-id="${c[0]}"><div class="ph" data-w="${c[4]}">${c[4]?esc(c[1].split(" ").map(x=>x[0]).slice(0,2).join("")):"🥩"}</div><div class="cb"><b>${c[1]}</b><small>${c[2]}</small><div class="pr">≈ ${fmt(c[3])}</div></div></div>`).join("") + `</div>`;
  loadImgs();
}
const langSel = () => `<select class="pill" data-a="lang">${["uz","ru","en"].map(l=>`<option value="${l}" ${l===S.lang?"selected":""}>${l.toUpperCase()}</option>`).join("")}</select>`;

let shown = 0;
function tick() { const e=$("#bal"); if(!e) return; shown += (S.cash-shown)*.15; if (Math.abs(S.cash-shown)<.5) shown=S.cash; e.textContent=fmt(shown); if (shown!==S.cash) requestAnimationFrame(tick); }
function pct() { return Math.max(0, Math.min(100, S.spent/(S.start+S.loaned)*100)); }
function tier() { let k=-1; TH.forEach((x,i)=>{ if(pct()>=x) k=i; }); return k; }

function renderTop() {
  const c = CH.find(x=>x[0]===S.ch), p = pct(), k = tier();
  const cities = Object.keys(CITIES).concat(S.loc?["📍"]:[]);
  $("#top").innerHTML = `
  <div class="row sp"><button class="pill" data-a="back">${t("back")}</button><span class="who">${c[1]}</span>${langSel()}</div>
  <div class="row" style="margin:8px 0 2px">${["USD","RUB","UZS"].map(x=>`<button class="pill ${x===S.cur?"on":""}" data-a="cur" data-id="${x}">${x} (${SYM[x]})</button>`).join("")}<small style="color:var(--mu)">${t("rate")}: 1$ = ${Math.round(R.UZS)} so'm · ${R.RUB.toFixed(1)} ₽ (${live?t("live"):t("fb")})</small></div>
  <div class="bal"><small>${t("bal")}</small><div id="bal">${fmt(shown)}</div></div>
  <div class="stats"><div>${t("spent")}: <b>${p.toFixed(p<10?2:1)}%</b><div class="bar"><i style="width:${p}%"></i></div><small>${k>=0?t("a")[k]:""}</small></div>
  <div>${t("debt")}: <span class="debt">${fmt(S.debt)}</span><div class="row" style="margin-top:6px"><button class="pill" data-a="loanDlg">${t("loan")}</button><button class="pill" data-a="repay">${t("repay")}</button></div></div></div>
  <div class="row"><select class="pill" data-a="city" aria-label="${t("city")}">${cities.map(x=>`<option ${x===S.city?"selected":""}>${x}</option>`).join("")}</select><button class="pill" data-a="gps">${t("gps")}</button></div>
  <nav>${["shop","dn","mine","ord","near"].map(x=>`<button class="pill ${S.tab===x?"on":""}" data-a="tab" data-id="${x}">${t(x)}</button>`).join("")}</nav>`;
  tick();
}

function match(it, q) { return !q || it.n.some(n => n.toLowerCase().includes(q)); }
function card(it, d, shop) {
  const p = it.p*(d||1), q = S.inv[it.id]||0;
  return `<div class="card"><div class="ph" data-w="${it.w}">${it.e}</div><div class="cb"><b>${esc(it.n[L()])}</b>${d&&d<1?`<span class="tag">−${Math.round((1-d)*100)}% ${t("off")} · ${esc(shop)}</span>`:""}<div class="pr">${fmt(p)}</div><div class="qty"><button data-a="sell" data-id="${it.id}" ${q?"":"disabled"} aria-label="−">−</button><span>${q}</span><button data-a="buy" data-id="${it.id}" data-d="${d||1}" data-s="${esc(shop||"")}" aria-label="+">+</button></div></div></div>`;
}

function renderMain() {
  document.body.classList.toggle("dn", S.tab==="dn");
  const q = $("#q").value.trim().toLowerCase(), m = $("#main"), tab = S.tab;
  $("#tools").hidden = !(tab==="shop"||tab==="dn");
  $("#q").placeholder = t("search");
  $("#chips").innerHTML = tab==="shop" ? ["all","food","tech","auto","home","sky","lux"].map(c=>`<button class="pill ${S.cat===c?"on":""}" data-a="cat" data-id="${c}">${c==="all"?t("all"):t("c")[c]}</button>`).join("") : "";
  if (tab==="shop"||tab==="dn") {
    const list = ITEMS.filter(i => i.dn===(tab==="dn"?1:0) && (tab==="dn"||S.cat==="all"||i.c===S.cat) && match(i,q));
    m.innerHTML = `<div class="grid">${list.map(i=>card(i)).join("")}</div>`;
  } else if (tab==="mine") {
    const list = ITEMS.filter(i => S.inv[i.id]), tot = list.reduce((a,i)=>a+i.p*S.inv[i.id],0);
    m.innerHTML = list.length ? `<h3>${t("val")}: ${fmt(tot)}</h3><div class="grid">${list.map(i=>card(i)).join("")}</div>` : `<p class="sub">${t("empty")}</p>`;
  } else if (tab==="ord") {
    m.innerHTML = S.orders.length ? S.orders.map(o => {
      const it = ALL[o.id], age = (Date.now()-o.t)/1000, k = age<6?0:age<15?1:age<30?2:3;
      return `<div class="ord"><div class="e">${it.e}</div><div><b>${esc(it.n[L()])}</b><small>📍 ${esc(o.c)}${o.s?" · "+esc(o.s):""} · ${o.km} ${t("away")}</small><span class="stx">${t("st")[k]}</span>${k<3?`<small>${t("eta")} ${Math.max(1,Math.ceil((30-age)/5))} min</small>`:""}</div></div>`;
    }).join("") : `<p class="sub">${t("empty")}</p>`;
  } else {
    const [la,lo] = coords(), shops = SHOPS[S.city] || ["Local Market","Bazaar"], pool = ITEMS.filter(i=>!i.dn && i.p<=2e6);
    m.innerHTML = `<iframe title="map" loading="lazy" src="https://www.openstreetmap.org/export/embed.html?bbox=${lo-.05},${la-.03},${lo+.05},${la+.03}&layer=mapnik&marker=${la},${lo}"></iframe><h3>${t("nearT")}: ${esc(S.city)}</h3>` +
      shops.map(s => { const h = hash(s+S.city), km = (.4+h%40/10).toFixed(1); return `<h3>🏪 ${esc(s)} · ${km} ${t("away")}</h3><div class="grid">${[0,1,2].map(j=>card(pool[(h+j*7)%pool.length],.85,s)).join("")}</div>`; }).join("");
  }
  loadImgs();
}
const render = () => { renderTop(); renderMain(); };

function after() {
  const k = tier(); if (k > S.tier) { S.tier = k; toast("🏆 "+Math.round(pct())+"% — "+t("a")[k]); }
  save(); render();
}
function buy(id, d, shop) {
  const it = ALL[id], p = it.p*d;
  if (S.cash < p) return toast(t("warn"), 1);
  S.cash -= p; S.spent += p; S.inv[id] = (S.inv[id]||0)+1;
  const km = +(.5+hash(id+Date.now())%50/10).toFixed(1);
  S.orders.unshift({id, t:Date.now(), c:S.city==="📍"?"📍":S.city, s:shop, km}); S.orders = S.orders.slice(0,40);
  toast("🛵 "+it.n[L()]+" — "+t("st")[0]); after();
}
function sell(id) {
  if (!S.inv[id]) return; const g = ALL[id].p*.75;
  S.cash += g; S.spent -= g; if (--S.inv[id] <= 0) delete S.inv[id];
  toast("💰 "+t("sold")+": "+fmt(g)); after();
}
function loan(a) {
  if (S.debt + a*1.2 > 1.2e6 + .01) return toast(t("limit"), 1);
  S.cash += a; S.loaned += a; S.debt += a*1.2; $("#dlg").close(); toast(t("ok")); after();
}
function repay() {
  const x = Math.min(S.cash, S.debt); if (x < .01) return toast(t("noDebt"), 1);
  S.cash -= x; S.debt = S.debt-x < .01 ? 0 : S.debt-x; toast(t("paid")); after();
}
function start(id) {
  const c = CH.find(x=>x[0]===id);
  Object.assign(S, {ch:id, cash:c[3], start:c[3], loaned:0, debt:0, spent:0, inv:{}, orders:[], tier:-1, tab:"shop", cat:"all"});
  shown = S.cash; show(); save();
}
function show() {
  const g = !!S.ch; $("#pick").hidden = g; $("#game").hidden = !g;
  g ? render() : renderPick();
}

document.addEventListener("click", e => {
  const b = e.target.closest("[data-a]"); if (!b || b.tagName==="SELECT") return;
  const a = b.dataset.a, id = b.dataset.id;
  if (a==="start") start(id);
  else if (a==="back") { S.ch=""; save(); show(); }
  else if (a==="cur") { S.cur=id; save(); shown=S.cash; render(); }
  else if (a==="tab") { S.tab=id; save(); render(); }
  else if (a==="cat") { S.cat=id; save(); renderMain(); }
  else if (a==="buy") buy(id, +b.dataset.d, b.dataset.s);
  else if (a==="sell") sell(id);
  else if (a==="repay") repay();
  else if (a==="loan") loan(+id);
  else if (a==="loanDlg") { const d=$("#dlg"); d.innerHTML=`<p style="margin-bottom:6px">${t("about")}</p>`+[1e4,1e5,1e6].map(v=>`<button class="pill" data-a="loan" data-id="${v}">+ ${fmt(v)} → ${t("debt")} ${fmt(v*1.2)}</button>`).join("")+`<button class="pill" onclick="this.closest('dialog').close()">✕</button>`; d.showModal(); }
  else if (a==="gps") {
    if (!navigator.geolocation) return toast("GPS yo'q", 1);
    navigator.geolocation.getCurrentPosition(p => { S.loc=[p.coords.latitude,p.coords.longitude]; S.city="📍"; save(); render(); }, () => toast("GPS ruxsati berilmadi", 1));
  }
});
document.addEventListener("change", e => {
  const a = e.target.dataset.a;
  if (a==="lang") { S.lang=e.target.value; document.documentElement.lang=S.lang; save(); show(); }
  else if (a==="city") { S.city=e.target.value; save(); render(); }
});
$("#q").addEventListener("input", renderMain);
setInterval(() => { if (S.ch && S.tab==="ord") renderMain(); }, 2500);

function getRates() {
  fetch("/api/rates").then(r=>r.json()).then(j => { R=j.rates; live=j.live; if (S.ch) renderTop(); else renderPick(); }).catch(()=>{});
}
document.documentElement.lang = S.lang;
if (S.ch && typeof S.cash!=="number") S.ch = "";
shown = S.cash || 0; show(); getRates(); setInterval(getRates, 600000);
</script>
</body>
</html>
