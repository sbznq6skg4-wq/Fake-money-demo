body.dn{--bg:#07050b;--pn:#120c1c;--ln:#3a1f4d;--ac:#ff2d75;--mu:#a48bbd}
*{box-sizing:border-box;margin:0}
body{font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;background:var(--bg);color:var(--tx);min-height:100vh;padding-bottom:40px;transition:background .3s}
body.dn{font-family:ui-monospace,Menlo,Consolas,monospace;background:radial-gradient(800px 400px at 50% -10%,#3b0a2e,transparent),var(--bg)}
button,select,input{font:inherit;color:inherit}
button{cursor:pointer}
.wrap{max-width:1100px;margin:0 auto;padding:0 14px}
h1{font-size:clamp(1.5rem,5vw,2.3rem);margin:22px 0 4px}
.sub{color:var(--mu);margin-bottom:16px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(160px,1fr));gap:12px}
.card{background:var(--pn);border:1px solid var(--ln);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;transition:transform .15s,border-color .2s}
.card:hover{transform:translateY(-3px);border-color:var(--ac)}
.ph{position:relative;aspect-ratio:4/3;display:grid;place-items:center;font-size:2.6rem;background:linear-gradient(135deg,#232a52,#141833);overflow:hidden}
body.dn .ph{background:linear-gradient(135deg,#2b0f3d,#0d0714)}
.ph img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;object-position:top}
.cb{padding:10px;display:flex;flex-direction:column;gap:6px;flex:1}
.cb b{font-size:.92rem;line-height:1.25}
.cb small{color:var(--mu)}
.pr{color:var(--ac);font-weight:800;margin-top:auto;word-break:break-word}
.qty{display:flex;align-items:center;justify-content:space-between;background:#0d1020;border-radius:12px;padding:3px}
.qty button{width:38px;height:34px;border:0;border-radius:10px;background:var(--ac);color:#111;font-weight:800;font-size:1.1rem}
.qty button:disabled{background:#2a2f4d;color:#666;cursor:not-allowed}
.char{cursor:pointer;text-align:center}
.char .ph{aspect-ratio:1;font-size:3.4rem}
header{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--ln);padding:10px 0 8px}
.row{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.row.sp{justify-content:space-between}
.pill{border:1px solid var(--ln);background:var(--pn);border-radius:99px;padding:7px 13px;font-size:.88rem}
.pill.on{background:var(--ac);color:#111;border-color:var(--ac);font-weight:700}
select.pill{padding-right:8px}
.who{font-weight:700}
.bal small{color:var(--mu)}
#bal{font-size:clamp(1.6rem,7.5vw,3rem);font-weight:900;line-height:1.1;color:var(--ok);word-break:break-all;font-variant-numeric:tabular-nums}
.stats{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin:8px 0;font-size:.85rem}
.stats>div{background:var(--pn);border:1px solid var(--ln);border-radius:12px;padding:8px}
.bar{height:6px;background:#232848;border-radius:9px;margin:5px 0;overflow:hidden}
.bar i{display:block;height:100%;background:var(--ac);width:0;transition:width .5s}
.debt{color:var(--bad);font-weight:800}
nav{display:flex;gap:6px;overflow-x:auto;padding:4px 0}
nav .pill{white-space:nowrap}
#tools{display:flex;flex-direction:column;gap:8px;margin:12px 0}
#q{width:100%;background:var(--pn);border:1px solid var(--ln);border-radius:12px;padding:11px 14px;outline:0}
#q:focus{border-color:var(--ac)}
#chips{display:flex;gap:6px;overflow-x:auto}
.ord{background:var(--pn);border:1px solid var(--ln);border-radius:14px;padding:12px;margin-bottom:10px;display:flex;gap:12px;align-items:center}
.ord .e{font-size:2rem}
.ord small{color:var(--mu);display:block}
.ord .stx{color:var(--ok);font-weight:700}
iframe{width:100%;height:230px;border:1px solid var(--ln);border-radius:14px;margin-bottom:14px;filter:invert(.9) hue-rotate(180deg)}
h3{margin:14px 0 8px}
.tag{color:var(--ok);font-size:.8rem;font-weight:700}
dialog{background:var(--pn);color:var(--tx);border:1px solid var(--ac);border-radius:18px;padding:20px;max-width:340px;width:90%}
dialog::backdrop{background:#000a}
dialog .pill{display:block;width:100%;margin-top:8px;text-align:center}
#toast{position:fixed;left:50%;bottom:20px;transform:translate(-50%,120px);background:#fff;color:#111;padding:12px 18px;border-radius:14px;font-weight:600;max-width:92%;transition:transform .3s;z-index:20;text-align:center}
#toast.show{transform:translate(-50%,0)}
#toast.err{background:var(--bad);color:#fff}
.foot{color:var(--mu);font-size:.78rem;text-align:center;margin-top:24px}
</style>
</head>
